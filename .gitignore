outputs/
data/generated/

# Locally-downloaded datasets (e.g. Kaggle CSVs for
# recsys/calibration/fit_from_kaggle.py) — never committed, per
# CONTRIBUTING.md's "no large generated datasets" rule and Kaggle's own
# redistribution terms.
#
# Anchored with a leading slash. Without it the pattern matched at every
# level and silently swallowed recsys/data/, whose small committed JSON
# references recsys imports at runtime — ML tests failed on a fresh clone.
/data/

# Raw collector output: a 29 MB SQLite plus ~24 MB of raw API dumps.
x5_ready_food_collector/data/

# Notebooks
.ipynb_checkpoints/

# Local LLM response cache and raw live-run dumps (recsys.llm_intent_eval,
# recsys.llm_audit) — regenerable from the cache/seed, megabytes per run, not
# meant to accumulate in every clone. See
# docs/research/recsys/llm-intent-eval.md for how to reproduce a report.
.cache/
reports/

# Materialised evaluation panels: ~6 MB of gzipped profiles and inventories,
# rebuilt by `python -m recsys.panels`. The manifests next to them ARE
# committed — they carry the generator version, the catalog hash and the
# content checksums, which is what a reviewer needs and what `load_panel`
# verifies a rebuild against. Committing the payload too would put megabytes
# of regenerable data in every clone to prove something the checksum already
# proves.
recsys/data/panels/**/panel.json.gz
